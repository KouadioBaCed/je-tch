# --- Inscriptions → Google Sheets (via Google Apps Script) -------------------
# 1. Déploie docs/google-sheets-apps-script.gs en « application web ».
# 2. Copie l'URL qui se termine par /exec ci-dessous.
# 3. Renseigne le même secret que la constante SECRET du script (ou laisse vide).
# 4. Copie ce fichier en « .env.local » et relance `npm run dev`.
#
# .env.local n'est lu qu'au démarrage du serveur : redémarre après modification.

GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxogZGYnuvRoSxYufoCtOXd0yjUFB1GYk1DIct8SpNGnGVK5EJ8XLCHUrMRLUMzH57qHw/exec
GOOGLE_SHEETS_SECRET='AKfycbxogZGYnuvRoSxYufoCtOXd0yjUFB1GYk1DIct8SpNGnGVK5EJ8XLCHUrMRLUMzH57qHw'
